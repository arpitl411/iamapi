{
  "info": {
    "name": "IAM API",
    "description": "Identity & Access Management API — full endpoint collection.\n\n**Setup:**\n1. Import this collection\n2. Import `IAM-API.postman_environment.json` alongside it\n3. Select the `IAM API - Local` environment\n4. Run **Auth / Login** — the token is auto-saved to `{{token}}`\n5. All protected routes use `{{token}}` automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "orgId",
      "value": "org_123",
      "type": "string"
    },
    {
      "key": "calculatorId",
      "value": "calculator_id_here",
      "type": "string"
    },
    {
      "key": "pageId",
      "value": "page_id_here",
      "type": "string"
    },
    {
      "key": "sectionId",
      "value": "section_id_here",
      "type": "string"
    },
    {
      "key": "fieldId",
      "value": "field_id_here",
      "type": "string"
    },
    {
      "key": "formulaId",
      "value": "formula_id_here",
      "type": "string"
    },
    {
      "key": "ruleId",
      "value": "rule_id_here",
      "type": "string"
    },
    {
      "key": "integrationId",
      "value": "integration_id_here",
      "type": "string"
    },
    {
      "key": "apiV1Prefix",
      "value": "api/v1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"secret123\",\n  \"phone_country_code\": \"+1\",\n  \"phone_no\": \"5555555555\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.access_token) {",
                  "  pm.environment.set('token', res.data.access_token);",
                  "  console.log('Token saved to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth", "host": ["{{baseUrl}}"], "path": ["auth"] }
          }
        },
        {
          "name": "Get Me (Current User)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/1", "host": ["{{baseUrl}}"], "path": ["auth", "1"] }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/1", "host": ["{{baseUrl}}"], "path": ["auth", "1"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"email\": \"jane.doe@example.com\"\n}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/auth/1", "host": ["{{baseUrl}}"], "path": ["auth", "1"] }
          }
        }
      ]
    },
